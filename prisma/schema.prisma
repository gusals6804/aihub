generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model Browser {
  id String @id
  tokenHash String @unique
  createdAt DateTime @default(now())
}
model Content {
  id String @id
  creatorId String
  kind String
  title String
  description String
  category String
  visibility String @default("link")
  definition String
  html String?
  url String?
  editHash String
  recoveryHash String @unique
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([creatorId])
  @@index([visibility])
}
model Share {
  id String @id
  contentId String
  tokenHash String @unique
  revoked Boolean @default(false)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  @@index([contentId])
}
model Favorite {
  browserId String
  key String
  data String
  @@id([browserId, key])
}
model Progress {
  browserId String
  tutorial String
  step Int @default(0)
  @@id([browserId, tutorial])
}
model Execution {
  id String @id
  browserId String
  contentId String
  status String
  errorCode String?
  durationMs Int
  createdAt DateTime @default(now())
}
model Throttle {
  key String @id
  count Int @default(0)
  expiresAt DateTime
}
