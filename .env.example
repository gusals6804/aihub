# ============================================================
# Agent Hub 환경변수
# 이 파일을 복사해 .env 로 저장하고 값을 채우세요.
#   copy .env.example .env   (Windows)
# 실제 키는 절대 소스코드/깃에 넣지 마세요.
# ============================================================

# SQLite 데이터베이스 파일 위치 (프로젝트 루트 기준)
DATABASE_URL="file:./dev.db"

# 서비스 기본 주소. 사내 공유 시 노트북 IP로 바꾸세요.
# 예: http://192.168.0.42:3000
APP_BASE_URL="http://localhost:3000"

# ----- 네이버 뉴스 검색 (시장 뉴스 브리핑) -----
# 발급: https://developers.naver.com/apps/#/register (무료, 검색 API 추가)
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ----- OpenDART 전자공시 (잠재고객 탐색의 기업개황 확인) -----
# 발급: https://opendart.fss.or.kr/ (무료, 이메일 인증)
DART_API_KEY=""

# ----- FRED (환율 DEXKOUS, 미국 국채 금리 DGS2/DGS10) -----
# 발급: https://fredaccount.stlouisfed.org/apikeys (무료)
FRED_API_KEY=""

# ----- 카카오 로컬 (장소 검색·좌표 변환: 잠재고객·야장맵·웨딩홀·여행) -----
# 발급: https://developers.kakao.com/console/app → 앱 키 중 "REST API 키"
KAKAO_REST_API_KEY=""

# ----- Claude API (AI 요약·번역·해석 생성) -----
# 발급: https://console.anthropic.com/settings/keys (유료, 소액 충전)
# 이 키가 없어도 뉴스 목록·수치·지도 등 데이터 조회 기능은 동작합니다.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ----- 운영 옵션 -----
# 직원 셀프 가입 허용 여부. 0이면 관리자만 계정을 만들 수 있습니다.
ALLOW_SELF_REGISTER="1"
# HTTPS 뒤에서 운영할 때만 1로 (쿠키 Secure 플래그)
FORCE_SECURE_COOKIES="0"
# 업로드 HTML 최대 크기 (바이트)
HTML_UPLOAD_MAX_BYTES="2000000"
# 요청 속도 제한
RATE_LIMIT_MAX_REQUESTS="20"
RATE_LIMIT_WINDOW_MINUTES="10"
# URL 요약 에이전트가 가져올 수 있는 도메인 허용 목록 (비우면 공개 URL 전체)
URL_FETCH_ALLOWLIST=""
URL_FETCH_MAX_BYTES="1500000"
# 아침 브리핑 잡 보호용 시크릿 (외부 노출 배포 시 설정)
CRON_SECRET=""

# 로그인 강제 여부. 기본 0 = 오픈 모드(로그인 없이 게스트로 열람·실행·만들기·공유 가능,
# 관리자 화면과 실제 계정 소유 콘텐츠의 수정·삭제만 로그인 필요). 1 = 전 기능 로그인 필수.
REQUIRE_LOGIN="0"
