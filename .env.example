# Agent Hub · 실제 비밀값을 소스코드나 Git에 넣지 마세요.
# 기존 .env가 있다면 덮어쓰지 마세요. 운영자가 필요한 값만 추가합니다.
# 기존 DATABASE_URL/dev.db와 분리하여 새 익명 DB를 사용합니다.
# HUB_DATABASE_URL="file:/absolute/path/agent-hub.db"
APP_BASE_URL="http://localhost:5000"

# 네이버 검색 API · developers.naver.com
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
# 카카오 로컬 REST API · developers.kakao.com
KAKAO_REST_API_KEY=""
# OpenDART 기업개황 · opendart.fss.or.kr
DART_API_KEY=""
# FRED 관측값 · fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=""
# AI 번역·요약 · console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# HTTPS 프록시 뒤에서만 Secure 쿠키를 강제합니다.
FORCE_SECURE_COOKIES="0"
# 프록시가 외부 전달 헤더를 제거·재설정할 때만 1
TRUST_PROXY="0"
# 15분당 브라우저/IP 실행 한도
RUN_SESSION_LIMIT="30"
RUN_IP_LIMIT="60"
# 파일 2MB, 본문 3MB, 동시 실행 3개 제한은 서버 코드에 고정되어 있습니다.
# 계정·가입·로그인 설정은 사용하지 않습니다.
